{
    "redirects": [
        { "source": "/enf", "destination": "/tecnicoemenfermagem", "permanent": true },
        { "source": "/enf/(.*)", "destination": "/tecnicoemenfermagem/$1", "permanent": true }
    ],
    "rewrites": [
        { "source": "/enfermagem", "destination": "/index.html" },
        { "source": "/enfermagem/(.*)", "destination": "/index.html" },
        { "source": "/enfermagem02", "destination": "/enfermagem02.html" },
        { "source": "/enfermagem02/(.*)", "destination": "/enfermagem02.html" },
        { "source": "/tecnicoemenfermagem", "destination": "/tecnicoemenfermagem/index.html" },
        { "source": "/tecnicoemenfermagem/(.*)", "destination": "/tecnicoemenfermagem/index.html" }
    ]
}
